<actionGroups xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/actionGroupSchema.xsd">
    <actionGroup name="AssertAdminAdobeStockThumbnailsNumberActionGroup">
        <arguments>
            <argument name="thumbnailsNumber" type="string" defaultValue="{{AdobeStockModalData.thumbnailsNumber}}"/>
            <!-- Zero-based index of the last expected thumbnail (data-repeat-index) — must equal thumbnailsNumber - 1 -->
            <argument name="lastThumbnailIndex" type="string" defaultValue="31"/>
        </arguments>
        <waitForElementVisible selector="{{AdminAdobeStockSection.modal}} {{AdminAdobeStockSection.imageInGridByIndex(lastThumbnailIndex)}}" stepKey="waitForLastThumbnail"/>
        <seeNumberOfElements selector="{{AdminAdobeStockSection.modal}} {{AdminAdobeStockSection.firstImageInGrid}}" userInput="{{thumbnailsNumber}}" stepKey="seeCorrectThumbnailsNumber"/>
    </actionGroup>
</actionGroups>
